          "name": "Send message while blocked - failure",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"body\": \"Blocked message\"\n}" },
            "url": "{{base_url}}/api/v1/conversations/{{conversation_id}}/messages",
            "description": "Expected: 403. Existing conversations remain stored, but messaging is restricted."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 403', function () { pm.response.to.have.status(403); });"] } }]
        },
        {
          "name": "Unblock recipient - success",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "url": "{{base_url}}/api/v1/blocks/{{recipient_public_id}}",
            "description": "Expected: 200. Normal interaction is restored subject to privacy rules."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }]
        }
